{
  "name": "fos-project",
  "version": "0.1.2",
  "mcpServers": {
    "fos-project": {
      "command": "node",
      "args": [
        "${extensionPath}/scripts/bridge.mjs"
      ],
      "env": {
        "FOS_AGENT_CONNECTION": "${FOS_AGENT_CONNECTION}"
      }
    }
  },
  "settings": [
    {
      "name": "Fos agent connection file",
      "description": "Absolute path to the scoped connection JSON created by scripts/connect.mjs.",
      "envVar": "FOS_AGENT_CONNECTION"
    }
  ]
}
