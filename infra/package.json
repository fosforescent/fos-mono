{
  "name": "@fosforescent/infra",
  "version": "0.1.7",
  "type": "module",
  "main": "index.ts",
  "exports": {
    "./prismaClient": "./prismaClient.ts"
  },
  "scripts": {
    "test:api": "node apiTests/auth-flow.test.cjs",
    "test:api:auth": "node apiTests/auth-flow.test.cjs",
    "test:api:ws": "node apiTests/websocket-flow.test.cjs",
    "test:api:all": "npm run test:api && npm run test:api:ws",
    "setup": "npm install",
    "db:generate": "cd prisma && prisma generate",
    "db:push": "cd prisma && prisma db push",
    "db:migrate": "cd prisma && prisma migrate dev",
    "db:reset": "cd prisma && prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "openai": "^4.73.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.7",
    "typescript": "^5.6.3",
    "concurrently": "^9.0.1",
    "prisma": "^6.9.0",
    "tsx": "^4.19.2",
    "bcrypt": "^5.1.1",
    "@types/bcrypt": "^5.0.2",
    "ws": "^8.14.2"
  }
}
