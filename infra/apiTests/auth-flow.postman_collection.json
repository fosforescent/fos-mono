{
  "info": {
    "name": "Fosforescent Auth Flow",
    "description": "Authentication flow testing for Fosforescent API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "testUsername",
      "value": "testuser_{{$timestamp}}",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "TestPass123",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Health check returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Check Username Availability",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Username check returns valid response', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\\n  \\\"username\\\": \\\"{{testUsername}}\\\"\\n}"
        },
        "url": "{{baseUrl}}/auth/check-username"
      }
    },
    {
      "name": "Register New User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User registration successful', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains user data', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('user_name');",
              "    pm.expect(responseJson.user_name).to.eql(pm.variables.get('testUsername'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\\n  \\\"username\\\": \\\"{{testUsername}}\\\",\\n  \\\"password\\\": \\\"{{testPassword}}\\\",\\n  \\\"accepted_terms\\\": true,\\n  \\\"cookies\\\": {}\\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login successful', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains JWT token', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('token');",
              "    pm.expect(responseJson.token).to.be.a('string');",
              "    pm.expect(responseJson.token.length).to.be.greaterThan(0);",
              "    ",
              "    // Store token for subsequent requests",
              "    pm.collectionVariables.set('authToken', responseJson.token);",
              "});",
              "",
              "pm.test('Response contains user info', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('username');",
              "    pm.expect(responseJson.username).to.eql(pm.variables.get('testUsername'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\\n  \\\"username\\\": \\\"{{testUsername}}\\\",\\n  \\\"password\\\": \\\"{{testPassword}}\\\"\\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Verify JWT Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('JWT verification successful', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('JWT contains valid claims', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('username');",
              "    pm.expect(responseJson.username).to.eql(pm.variables.get('testUsername'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/verify-jwt"
      }
    },
    {
      "name": "Get User Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User profile retrieved successfully', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Profile contains user data', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('user_name');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/user/profile"
      }
    },
    {
      "name": "Get User Data",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User data retrieved successfully', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Data contains graph context', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('data');",
              "    pm.expect(responseJson).to.have.property('updated');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/user/data"
      }
    },
    {
      "name": "Test Invalid Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Invalid login returns 401 or 404', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([401, 404]);",
              "});",
              "",
              "pm.test('Error message provided', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('error');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\\n  \\\"username\\\": \\\"{{testUsername}}\\\",\\n  \\\"password\\\": \\\"WrongPassword123\\\"\\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Test Missing Credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Missing credentials returns 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Error message indicates missing credentials', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('error');",
              "    pm.expect(responseJson.error.toLowerCase()).to.include('missing');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\\n  \\\"username\\\": \\\"\\\",\\n  \\\"password\\\": \\\"\\\"\\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Test Weak Password Registration",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Weak password registration returns 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Error message indicates password requirements', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('error');",
              "    pm.expect(responseJson.error.toLowerCase()).to.include('password');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\\n  \\\"username\\\": \\\"{{testUsername}}_weak\\\",\\n  \\\"password\\\": \\\"weak\\\",\\n  \\\"accepted_terms\\\": true,\\n  \\\"cookies\\\": {}\\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Test Duplicate Username Registration",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Duplicate username returns 409', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "pm.test('Error message indicates user already exists', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('error');",
              "    pm.expect(responseJson.error.toLowerCase()).to.include('exists');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\\n  \\\"username\\\": \\\"{{testUsername}}\\\",\\n  \\\"password\\\": \\\"{{testPassword}}\\\",\\n  \\\"accepted_terms\\\": true,\\n  \\\"cookies\\\": {}\\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Test Registration Without Accepting Terms",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Registration without terms returns 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Error message indicates terms must be accepted', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('error');",
              "    pm.expect(responseJson.error.toLowerCase()).to.include('terms');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\\n  \\\"username\\\": \\\"{{testUsername}}_terms\\\",\\n  \\\"password\\\": \\\"{{testPassword}}\\\",\\n  \\\"accepted_terms\\\": false,\\n  \\\"cookies\\\": {}\\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Test Protected Endpoint Without Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Protected endpoint without token returns 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/user/profile"
      }
    },
    {
      "name": "Test Protected Endpoint With Invalid Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Protected endpoint with invalid token returns 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid.jwt.token"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/user/profile"
      }
    }
  ]
}