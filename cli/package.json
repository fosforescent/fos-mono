{
  "name": "@fosforescent/cli",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "fos": "dist/index.mjs",
    "cli": "dist/index.mjs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --sourcemap --outfile=dist/index.mjs --external:yaml",
    "start": "node dist/index.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@fosforescent/shared": "file:../shared",
    "kleur": "^4.1.5",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "esbuild": "^0.18.20",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
