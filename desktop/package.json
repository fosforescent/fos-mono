{
  "name": "@fosforescent/desktop",
  "version": "0.1.4",
  "description": "Fosforescent Desktop and Mobile App",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "tauri build",
    "dev:web": "cd ../web && npm run dev",
    "build:web": "cd ../web && npm run build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "build:core": "node ../scripts/build-core.cjs",
    "prepare:agents": "npm ci --prefix agent-runtime --ignore-scripts --omit=optional"
  },
  "keywords": [
    "fosforescent",
    "desktop",
    "tauri",
    "mobile",
    "ios",
    "android"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/cli": "^2.9.6"
  }
}
