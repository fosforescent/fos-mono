{
  "name": "@fosforescent/desktop",
  "version": "0.1.1",
  "description": "Fosforescent Desktop and Mobile App",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "cd ../web && npm run dev",
    "build:web": "cd ../web && npm run build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "build:core": "esbuild ../shared/sync/embed.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=src-tauri/js/fos-core.js --inject:src-tauri/js/prelude.js",
    "prepare:agents": "npm ci --prefix agent-runtime --ignore-scripts"
  },
  "keywords": [
    "fosforescent",
    "desktop",
    "tauri",
    "mobile",
    "ios",
    "android"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/cli": "^2.9.6"
  }
}
