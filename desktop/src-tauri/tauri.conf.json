{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fosforescent",
  "version": "0.0.1",
  "identifier": "com.fosforescent.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run build:core && npm run prepare:agents && npm run dev:web",
    "beforeBuildCommand": "npm run build:core && npm run prepare:agents && npm run build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Fosforescent",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "2H3235CJSL",
      "minimumSystemVersion": "15.0",
      "bundleVersion": "1005"
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1005
    },
    "resources": {
      "../agent-runtime/": "agent-runtime/",
      "../../scripts/desktop-cli-path.ps1": "desktop-cli-path.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
