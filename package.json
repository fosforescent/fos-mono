{
  "name": "@fosforescent/fos-mono",
  "version": "0.1.7",
  "scope": "@fosforescent",
  "private": true,
  "workspaces": [
    "backend",
    "shared",
    "infra",
    "desktop"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:web\"",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm run build",
    "dev:backend": "cd backend && npm run dev",
    "dev:desktop": "cd desktop && npm run dev",
    "build:desktop": "cd desktop && npm run build",
    "build": "npm run build:web && npm run build:backend",
    "build:backend": "cd backend && npm run build",
    "test": "npm run test:web && npm run test:backend",
    "test:backend": "cd backend && npm run test",
    "test:web": "cd web && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "esbuild": "^0.18.20",
    "vite": "^5.0.0",
    "wait-on": "^8.0.1"
  }
}
