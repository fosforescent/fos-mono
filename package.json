{
  "name": "@fosforescent/fos-mono",
  "version": "0.1.7",
  "scope": "@fosforescent",
  "private": true,
  "bin": {
    "cli": "bin/fos-cli.js",
    "fos": "bin/fos-cli.js"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared",
    "infra",
    "cli"
  ],
  "scripts": {
    "cli": "npm run --workspace cli dev -- --dir ../.fos",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm run test",
    "test:backend": "cd backend && npm run test",
    "test:frontend:watch": "cd frontend && npm run test:watch",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "lint": "cd frontend && npm run lint && cd ../backend && npm run lint",
    "lint:fix": "cd frontend && npm run lint:fix && cd ../backend && npm run lint:fix",
    "storybook": "cd frontend && npm run storybook",
    "build-storybook": "cd frontend && npm run build-storybook"
  },
  "devDependencies": {
    "@fosforescent/cli": "workspace:*",
    "@vitejs/plugin-react": "^4.1.1",
    "concurrently": "^9.0.1",
    "esbuild": "^0.18.20",
    "vite": "^5.0.0",
    "wait-on": "^8.0.1"
  }
}
