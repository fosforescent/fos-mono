# Temporal Worker Dockerfile
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy source code
COPY . .

# Build TypeScript
RUN npm run build

# Expose any debugging ports if needed
EXPOSE 9090

# Start the Temporal worker
CMD ["node", "dist/temporal/worker.js"]