{
  "name": "@fosforescent/backend",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "nodemon --config nodemon.json",
    "prebuild": "node ../scripts/compile-library.cjs && npm run db:generate",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:generate": "prisma generate --schema=../infra/prisma/schema.prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx ../infra/prisma/seed.ts",
    "predev": "node ../scripts/compile-library.cjs"
  },
  "dependencies": {
    "@fosforescent/infra": "*",
    "@fosforescent/shared": "*",
    "@google-cloud/pubsub": "^4.0.0",
    "@google-cloud/vertexai": "^1.1.0",
    "@google/genai": "^1.52.0",
    "@prisma/client": "^6.8.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-slow-down": "^2.0.3",
    "js-sha3": "^0.9.3",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.73.0",
    "postmark": "^4.0.5",
    "stripe": "^17.3.1",
    "ua-parser-js": "^1.0.39",
    "uuid": "^11.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.7",
    "@types/postmark": "^1.4.1",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "3.3.3",
    "prisma": "^6.8.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "resolutions": {
    "jest": "28.1.3",
    "jest-runner": "28.1.3",
    "jest-environment-node": "28.1.3"
  }
}
